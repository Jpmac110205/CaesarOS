# Required live inference. Add values to your existing .env.
OPENAI_API_KEY=
# OpenAI_API_KEY is also accepted.
JEV_API_KEY=
# Jev_API_KEY or OPENROUTER_API_KEY is also accepted; this is an OpenRouter key.
CAESAROS_OPENAI_MODEL=gpt-4.1-mini
CAESAROS_JEV_MODEL=typesafe/jev-1.13
CAESAROS_TIMEZONE=America/New_York
CAESAROS_DATABASE=.data/caesaros.sqlite3
CAESAROS_STEP_DELAY=0
# Data adapters still use labeled local sample data. See docs/INTEGRATIONS.md.
# Optional Discord client (started separately).
# BOT_TOKEN=
# DISCORD_OWNER_ID=
# DISCORD_CHANNEL_ID=
# CAESAROS_API_URL=http://127.0.0.1:8000
