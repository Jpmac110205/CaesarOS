# Demo needs no credentials. Existing .env is never overwritten.
CAESAROS_REASONER=demo
CAESAROS_TIMEZONE=America/New_York
CAESAROS_DATABASE=.data/caesaros.sqlite3
CAESAROS_STEP_DELAY=0.35
# Optional live reasoning; data and actions remain local demo services.
# CAESAROS_REASONER=claude
# ANTHROPIC_API_KEY=
# CAESAROS_CLAUDE_MODEL=  # Model ID enabled in your Anthropic account.
# Optional Discord client (started separately).
# BOT_TOKEN=
# DISCORD_OWNER_ID=
# DISCORD_CHANNEL_ID=
# CAESAROS_API_URL=http://127.0.0.1:8000
# TODO: See docs/INTEGRATIONS.md for Prodigy, BeneFIT, Google, Jev and Bedrock.
